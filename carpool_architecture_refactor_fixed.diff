+    required String name,
+    required String email,
+    required String password,
+  });
+
+  /// Completes OTP / verification step (when enabled).
+  Future<AuthUserModel> verifyOtp(String email, String otp);
+
+  /// Signs out from the remote provider.
+  Future<void> logout();
+}
