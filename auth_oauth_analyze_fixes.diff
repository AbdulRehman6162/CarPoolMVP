+  initialSession,

+

+  /// User successfully signed in.

+  signedIn,

+

+  /// User signed out (explicitly or session expired).

+  signedOut,

+

+  /// Token refreshed.

+  tokenRefreshed,

+

+  /// User profile updated.

+  userUpdated,

+

+  /// Password recovery / reset flow triggered.

+  passwordRecovery,

+

+  /// Unknown or unmapped provider event.

+  unknown,

