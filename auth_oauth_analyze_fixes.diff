+import 'package:flutter/material.dart';

+import 'package:go_router/go_router.dart';

+import 'package:supabase_flutter/supabase_flutter.dart';

+

+/// Handles password recovery deep links.

+///

+/// Exchanges the recovery URL for a session. Router guards should then redirect

+/// the user to /update-password as needed.

+class AuthRecoveryCallbackPage extends StatefulWidget {

+  const AuthRecoveryCallbackPage({super.key});

+

+  @override

+  State<AuthRecoveryCallbackPage> createState() => _AuthRecoveryCallbackPageState();

+}

+

+class _AuthRecoveryCallbackPageState extends State<AuthRecoveryCallbackPage> {

+  @override

+  void initState() {

+    super.initState();

+    WidgetsBinding.instance.addPostFrameCallback((_) async {

+      final uri = GoRouterState.of(context).uri;

+

+      try {

+        final dynamic auth = Supabase.instance.client.auth;

+        await auth.getSessionFromUrl(uri);

+      } catch (_) {}

+

+      if (!mounted) return;

+      context.go('/update-password');

+    });

+  }

+

+  @override

+  Widget build(BuildContext context) {

+    return const Scaffold(

+      body: Center(child: CircularProgressIndicator()),

+    );

+  }

+}

