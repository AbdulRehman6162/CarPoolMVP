+import 'package:flutter/material.dart';

+import 'package:go_router/go_router.dart';

+import 'package:supabase_flutter/supabase_flutter.dart';

+

+/// Handles OAuth redirect deep links.

+///

+/// For Supabase PKCE OAuth flows, the app must exchange the redirect URL for a session.

+/// This page performs that exchange and then navigates away; routing guards handle

+/// any additional gating (email verification, password update, OTP, etc).

+class AuthCallbackPage extends StatefulWidget {

+  const AuthCallbackPage({super.key});

+

+  @override

+  State<AuthCallbackPage> createState() => _AuthCallbackPageState();

+}

+

+class _AuthCallbackPageState extends State<AuthCallbackPage> {

+  @override

+  void initState() {

+    super.initState();

+    // Exchange the deep link for a session.

+    WidgetsBinding.instance.addPostFrameCallback((_) async {

+      final uri = GoRouterState.of(context).uri;

+

+      try {

+        final dynamic auth = Supabase.instance.client.auth;

+        await auth.getSessionFromUrl(uri);

+      } catch (_) {

+        // If this fails, guards will route user back to login or show appropriate UI.

+      }

+

+      if (!mounted) return;

+      context.go('/');

+    });

+  }

+

+  @override

+  Widget build(BuildContext context) {

+    return const Scaffold(

+      body: Center(child: CircularProgressIndicator()),

+    );

+  }

+}

