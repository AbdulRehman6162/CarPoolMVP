+            final rides = prov.rides;
+
+            if (rides.isEmpty) {
+              return _EmptyState(
+                onArchived: () => context.go('/my-rides/archived'),
+              );
+            }
+
+            return ListView(
+              padding: const EdgeInsets.all(16),
+              children: [
+                ...rides.map((MyRide r) => Padding(
+                      padding: const EdgeInsets.only(bottom: 12),
+                      child: MyRideCard(
+                        ride: r,
+                        onTap: () => context.go('/my-rides/details', extra: r),
+                      ),
+                    )),
+                const SizedBox(height: 8),
+                _ArchivedButton(
+                  onTap: () => context.go('/my-rides/archived'),
+                ),
+              ],
+            );
+          },
+        ),
+      ),
     );
   }
 }
