import 'package:meta/meta.dart';

import 'my_ride_role.dart';
import 'my_ride_status.dart';
import 'ride_passenger.dart';
import 'ride_user.dart';

@immutable
class MyRide {
  final String id;

  // Sorting & timeline
  final DateTime departureTime;
  final DateTime arrivalTime;

  // Route
  final String fromCity;
  final String toCity;
  final String? fromAddress;
  final String? toAddress;

  // Role and state
  final MyRideRole role;
  final MyRideStatus status;

  /// Optional UI-facing badge like "Waiting for approval".
  final String? badgeLabel;

  // Pricing / seats
  final double pricePerSeat;
  final int totalSeats;
  final int bookedSeats;

  // Driver & passengers
  final RideUser driver;
  final List<RidePassenger> passengers;

  const MyRide({
    required this.id,
    required this.departureTime,
    required this.arrivalTime,
    required this.fromCity,
    required this.toCity,
    this.fromAddress,
    this.toAddress,
    required this.role,
    required this.status,
    this.badgeLabel,
    required this.pricePerSeat,
    required this.totalSeats,
    required this.bookedSeats,
    required this.driver,
    required this.passengers,
  });

  Duration get duration => arrivalTime.difference(departureTime);

  int get availableSeats => (totalSeats - bookedSeats).clamp(0, totalSeats);

  double get bookedPercent {
    if (totalSeats <= 0) return 0;
    return bookedSeats / totalSeats;
  }

  bool get isArchived => status == MyRideStatus.archived;

  bool get isDriver => role == MyRideRole.driver;
  bool get isPassenger => role == MyRideRole.passenger;
}

