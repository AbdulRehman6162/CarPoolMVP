    final arrive = loc.formatTimeOfDay(TimeOfDay.fromDateTime(ride.arrivalTime));

    final hours = ride.duration.inHours;
    final mins = ride.duration.inMinutes.remainder(60);
    final durationLabel = '${hours}h${mins.toString().padLeft(2, '0')}';

    final roleIcon = ride.isDriver ? Icons.directions_car : Icons.person;

    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(12),
      child: Card(
        elevation: 1,
        margin: EdgeInsets.zero,
        child: Padding(
