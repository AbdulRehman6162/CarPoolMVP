import '../../domain/entities/my_ride.dart';
import '../../domain/entities/my_ride_role.dart';
import '../../domain/entities/my_ride_status.dart';
import 'ride_passenger_model.dart';
import 'ride_user_model.dart';

class MyRideModel {
  final String id;
  final DateTime departureTime;
  final DateTime arrivalTime;
  final String fromCity;
  final String toCity;
  final String? fromAddress;
  final String? toAddress;
  final MyRideRole role;
  final MyRideStatus status;
  final String? badgeLabel;
  final double pricePerSeat;
  final int totalSeats;
  final int bookedSeats;
  final RideUserModel driver;
  final List<RidePassengerModel> passengers;

  const MyRideModel({
    required this.id,
    required this.departureTime,
    required this.arrivalTime,
    required this.fromCity,
    required this.toCity,
    this.fromAddress,
    this.toAddress,
    required this.role,
    required this.status,
    this.badgeLabel,
    required this.pricePerSeat,
    required this.totalSeats,
    required this.bookedSeats,
    required this.driver,
    required this.passengers,
  });

  factory MyRideModel.fromJson(Map<String, dynamic> json) => MyRideModel(
        id: json['id'] as String,
        departureTime: DateTime.parse(json['departureTime'] as String),
        arrivalTime: DateTime.parse(json['arrivalTime'] as String),
        fromCity: json['fromCity'] as String,
        toCity: json['toCity'] as String,
        fromAddress: json['fromAddress'] as String?,
        toAddress: json['toAddress'] as String?,
        role: MyRideRole.values.byName(json['role'] as String),
        status: MyRideStatus.values.byName(json['status'] as String),
        badgeLabel: json['badgeLabel'] as String?,
        pricePerSeat: (json['pricePerSeat'] as num).toDouble(),
        totalSeats: (json['totalSeats'] as num).toInt(),
        bookedSeats: (json['bookedSeats'] as num).toInt(),
        driver: RideUserModel.fromJson(json['driver'] as Map<String, dynamic>),
        passengers: (json['passengers'] as List<dynamic>? ?? const [])
            .map((e) => RidePassengerModel.fromJson(e as Map<String, dynamic>))
            .toList(),
      );

  Map<String, dynamic> toJson() => {
        'id': id,
        'departureTime': departureTime.toIso8601String(),
        'arrivalTime': arrivalTime.toIso8601String(),
        'fromCity': fromCity,
        'toCity': toCity,
        'fromAddress': fromAddress,
        'toAddress': toAddress,
        'role': role.name,
        'status': status.name,
        'badgeLabel': badgeLabel,
        'pricePerSeat': pricePerSeat,
        'totalSeats': totalSeats,
        'bookedSeats': bookedSeats,
        'driver': driver.toJson(),
        'passengers': passengers.map((p) => p.toJson()).toList(),
      };

  MyRide toEntity() => MyRide(
        id: id,
        departureTime: departureTime,
        arrivalTime: arrivalTime,
        fromCity: fromCity,
        toCity: toCity,
        fromAddress: fromAddress,
        toAddress: toAddress,
        role: role,
        status: status,
        badgeLabel: badgeLabel,
        pricePerSeat: pricePerSeat,
        totalSeats: totalSeats,
        bookedSeats: bookedSeats,
        driver: driver.toEntity(),
        passengers: passengers.map((p) => p.toEntity()).toList(),
      );

  static MyRideModel fromEntity(MyRide r) => MyRideModel(
        id: r.id,
        departureTime: r.departureTime,
        arrivalTime: r.arrivalTime,
        fromCity: r.fromCity,
        toCity: r.toCity,
        fromAddress: r.fromAddress,
        toAddress: r.toAddress,
        role: r.role,
        status: r.status,
        badgeLabel: r.badgeLabel,
        pricePerSeat: r.pricePerSeat,
        totalSeats: r.totalSeats,
        bookedSeats: r.bookedSeats,
        driver: RideUserModel.fromEntity(r.driver),
        passengers: r.passengers.map(RidePassengerModel.fromEntity).toList(),
      );
}

