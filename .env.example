# Environment Variables for AGENTS.md Architecture
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Supabase Configuration (Auth + Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Firebase Configuration (Push Notifications Only)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./credentials.json

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth (for Apple Sign-In)
APPLE_CLIENT_ID=com.yourapp.identifier
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_PATH=./apple_private_key.p8

# API Keys (if needed)
# GOOGLE_MAPS_API_KEY=your-maps-api-key
# SENDGRID_API_KEY=your-sendgrid-key

# Development Settings
ENVIRONMENT=development
DEBUG=true

# Google Sheets/Slides (for deliverables)
GOOGLE_SHEETS_CREDENTIALS=./credentials.json
GOOGLE_SHEETS_TOKEN=./token.json
