+import '../../../core/error/exception_mapper.dart';

+import '../../../core/result/result.dart';

+import '../domain/credentials/auth_credentials.dart';

+import '../domain/entities/auth_user.dart';

+import '../domain/repositories/auth_repository.dart';

+import 'strategies/auth_strategies.dart';

+

+class AuthFacade {

+  final AuthRepository _repo;

+  final List<AuthSignInStrategy> _signInStrategies;

+  final List<AuthSignUpStrategy> _signUpStrategies;

+  final List<AuthVerifyOtpStrategy> _verifyOtpStrategies;

+

+  AuthFacade({

+    required AuthRepository repo,

+    required List<AuthSignInStrategy> signInStrategies,

+    required List<AuthSignUpStrategy> signUpStrategies,

+    required List<AuthVerifyOtpStrategy> verifyOtpStrategies,

+  })  : _repo = repo,

+        _signInStrategies = signInStrategies,

+        _signUpStrategies = signUpStrategies,

+        _verifyOtpStrategies = verifyOtpStrategies;

+

+  Stream<AuthUser?> get authStateChanges => _repo.authStateChanges;

+  Future<AuthUser?> getCurrentUser() => _repo.getCurrentUser();

+

+  Future<Result<AuthUser>> signIn(AuthCredential credential) async {

+    final strategy =

+        _signInStrategies.firstWhere((s) => s.supports(credential), orElse: () {

+      throw StateError('No sign-in strategy registered for $credential');

+    });

+

+    try {

+      final user = await strategy.signIn(credential);

+      return Success(user);

+    } catch (e) {

+      return FailureResult(mapException(e));

+    }

+  }

+

+  Future<Result<void>> signUp(AuthCredential credential) async {

+    final strategy =

+        _signUpStrategies.firstWhere((s) => s.supports(credential), orElse: () {

+      throw StateError('No sign-up strategy registered for $credential');

+    });

+

+    try {

+      await strategy.signUp(credential);

+      return const Success(null);

+    } catch (e) {

+      return FailureResult(mapException(e));

+    }

+  }

+

+  Future<Result<AuthUser>> verifyOtp(AuthCredential credential) async {

+    final strategy = _verifyOtpStrategies

+        .firstWhere((s) => s.supports(credential), orElse: () {

+      throw StateError('No OTP verification strategy registered for $credential');

+    });

+

+    try {

+      final user = await strategy.verify(credential);

+      return Success(user);

+    } catch (e) {

+      return FailureResult(mapException(e));

+    }

+  }

+

+  Future<Result<void>> logout() async {

+    try {

+      await _repo.logout();

+      return const Success(null);

+    } catch (e) {

+      return FailureResult(mapException(e));

+    }

+  }

+}

