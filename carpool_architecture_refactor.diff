+import 'dart:async';

+

+import 'package:flutter/foundation.dart';

+

+import '../error/exception_mapper.dart';

+import '../error/failure.dart';

+import 'session_repository.dart';

+import 'session_user.dart';

+

+class SessionProvider extends ChangeNotifier {

+  final SessionRepository _repo;

+

+  late final StreamSubscription<SessionUser?> _sub;

+

+  SessionUser? _user;

+  bool _isInitialized = false;

+  Failure? _failure;

+

+  SessionProvider(this._repo) {

+    _sub = _repo.authStateChanges.listen((u) {

+      _user = u;

+      notifyListeners();

+    });

+    _bootstrap();

+  }

+

+  Future<void> _bootstrap() async {

+    try {

+      _user = await _repo.getCurrentUser();

+    } catch (e) {

+      _failure = mapException(e);

+    } finally {

+      _isInitialized = true;

+      notifyListeners();

+    }

+  }

+

+  bool get isInitialized => _isInitialized;

+  bool get isLoggedIn => _user != null;

+  SessionUser? get user => _user;

+

+  Failure? get failure => _failure;

+  String? get errorMessage => _failure?.userMessage;

+

+  void clearError() {

+    _failure = null;

+    notifyListeners();

+  }

+

+  Future<void> logout() async {

+    try {

+      await _repo.logout();

+    } catch (e) {

+      _failure = mapException(e);

+      notifyListeners();

+    }

+  }

+

+  @override

+  void dispose() {

+    _sub.cancel();

+    super.dispose();

+  }

+}

