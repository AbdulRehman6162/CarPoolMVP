--- a/lib/core/error/exception_mapper.dart
+++ b/lib/core/error/exception_mapper.dart
@@ -0,0 +1,32 @@
+import 'failure.dart';

+

+/// Maps arbitrary exceptions into typed [Failure]s.

+/// Keep this conservative to avoid leaking internal messages to users.

+Failure mapException(Object error) {

+  final msg = error.toString();

+

+  // Very common offline/timeouts from HTTP clients.

+  if (msg.contains('SocketException') ||

+      msg.contains('Failed host lookup') ||

+      msg.contains('Connection closed') ||

+      msg.contains('timed out')) {

+    return NetworkFailure(cause: error);

+  }

+

+  // Basic auth-ish heuristics (Supabase / common backends).

+  if (msg.toLowerCase().contains('invalid login') ||

+      msg.toLowerCase().contains('invalid credentials') ||

+      msg.toLowerCase().contains('wrong password') ||

+      msg.toLowerCase().contains('unauthorized')) {

+    return const AuthFailure(message: 'Invalid credentials.');

+  }

+

+  // Validation

+  if (msg.toLowerCase().contains('validation') ||

+      msg.toLowerCase().contains('required') ||

+      msg.toLowerCase().contains('must be')) {

+    return ValidationFailure(message: 'Please check your input.', cause: error);

+  }

+

+  return UnknownFailure(cause: error);

+}

