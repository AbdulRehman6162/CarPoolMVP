@@ -0,0 +1,42 @@
+abstract class Failure {

+  final String code;

+  final String message;

+  final Object? cause;

+

+  const Failure({

+    required this.code,

+    required this.message,

+    this.cause,

+  });

+

+  /// Safe, user-facing message (avoid leaking internals).

+  String get userMessage => message;

+

+  @override

+  String toString() => 'Failure(code: $code, message: $message)';

+}

+

+class UnknownFailure extends Failure {

+  const UnknownFailure({String message = 'Something went wrong.', Object? cause})

+      : super(code: 'unknown', message: message, cause: cause);

+}

+

+class NetworkFailure extends Failure {

+  const NetworkFailure({String message = 'Network error. Please try again.', Object? cause})

+      : super(code: 'network', message: message, cause: cause);

+}

+

+class ValidationFailure extends Failure {

+  const ValidationFailure({required String message, Object? cause})

+      : super(code: 'validation', message: message, cause: cause);

+}

+

+class AuthFailure extends Failure {

+  const AuthFailure({required String message, Object? cause})

+      : super(code: 'auth', message: message, cause: cause);

+}

+

+class UnauthorizedFailure extends Failure {

+  const UnauthorizedFailure({String message = 'Please log in to continue.', Object? cause})

+      : super(code: 'unauthorized', message: message, cause: cause);

+}

