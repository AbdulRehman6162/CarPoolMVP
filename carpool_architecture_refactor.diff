+++ b/lib/features/auth/application/strategies/email_password_auth_strategy.dart
@@ -0,0 +1,35 @@
+import '../../domain/credentials/auth_credentials.dart';

+import '../../domain/entities/auth_user.dart';

+import '../../domain/repositories/auth_repository.dart';

+import 'auth_strategies.dart';

+

+class EmailPasswordAuthStrategy

+    implements AuthSignInStrategy, AuthSignUpStrategy, AuthVerifyOtpStrategy {

+  final AuthRepository _repo;

+

+  EmailPasswordAuthStrategy(this._repo);

+

+  @override

+  bool supports(AuthCredential credential) =>

+      credential is EmailPasswordSignInCredential ||

+      credential is EmailPasswordSignUpCredential ||

+      credential is OtpVerificationCredential;

+

+  @override

+  Future<AuthUser> signIn(AuthCredential credential) async {

+    final c = credential as EmailPasswordSignInCredential;

+    return _repo.login(c.email, c.password);

+  }

+

+  @override

+  Future<void> signUp(AuthCredential credential) async {

+    final c = credential as EmailPasswordSignUpCredential;

+    return _repo.signup(name: c.name, email: c.email, password: c.password);

+  }

+

+  @override

+  Future<AuthUser> verify(AuthCredential credential) async {

+    final c = credential as OtpVerificationCredential;

+    return _repo.verifyOtp(c.email, c.otp);

+  }

+}

